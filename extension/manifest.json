{
  "manifest_version": 3,
  "name": "MSA 手牌記錄器",
  "version": "0.8.0",
  "description": "在本機整合 MSA 自己的手牌、雙方公開出牌與 Battle Log，依回合檢視並匯出賽後分析資料。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.gundam-gcg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MSA 手牌記錄器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mobilesuitarena.com/*"
      ],
      "js": [
        "recorder-core.js",
        "battle-log-core.js",
        "diagnostics-core.js",
        "dom-reader.js",
        "capture-coordinator.js",
        "deck-tracker-wire.js",
        "wasm/deck_tracker.js",
        "deck-tracker-core.js",
        "live-panel-core.js",
        "deck-tracker-ui.js",
        "live-panel-ui.js",
        "live-panel-controller.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wasm/deck_tracker_bg.wasm"],
      "matches": ["https://mobilesuitarena.com/*"]
    }
  ]
}
